# Suomen-listan tai Finland-ryhmän julkinen Mailchimp-lomakeosoite. Ei salaisuus.
PUBLIC_MAILCHIMP_ACTION=

# Mailchimpin yleisökenttä, johon tallennetaan suostumuksen versio.
# Esimerkki: FICONSENT
PUBLIC_MAILCHIMP_CONSENT_NAME=
PUBLIC_MAILCHIMP_CONSENT_VALUE=

# Mailchimpin embed-koodissa näkyvän bottiloukun nimi.
# Esimerkki: b_0123456789abcdef_0123456789
PUBLIC_MAILCHIMP_HONEYPOT_NAME=

# Finland-lomakkeeseen automaattisesti liitetyn Mailchimp-tagin tunniste.
PUBLIC_MAILCHIMP_TAG_ID=

# Footerkontakt. Byt först när hei@splatter.fi är skapat och testat som alias.
PUBLIC_CONTACT_EMAIL=hej@splatter.se

# Valfri landningssidevariant. Skickas aldrig med e-postadressen i URL eller analysdata.
PUBLIC_LANDING_VARIANT=default

# Skapa först riktiga dolda Text-fält i Mailchimp och klistra sedan in de faktiska
# HTML-fältnamnen från Mailchimps embed-kod. Lämna tomma tills dess.
PUBLIC_MAILCHIMP_UTM_SOURCE_NAME=
PUBLIC_MAILCHIMP_UTM_MEDIUM_NAME=
PUBLIC_MAILCHIMP_UTM_CAMPAIGN_NAME=
PUBLIC_MAILCHIMP_UTM_CONTENT_NAME=
PUBLIC_MAILCHIMP_VARIANT_NAME=

# Valfria first-party-endpoints. Lämna tomma tills en säker backend har valts.
PUBLIC_SURVEY_ENDPOINT=
PUBLIC_ANALYTICS_ENDPOINT=
