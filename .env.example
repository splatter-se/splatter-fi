# Suomen-listan tai Finland-ryhmän julkinen Mailchimp-lomakeosoite. Ei salaisuus.
PUBLIC_MAILCHIMP_ACTION=

# Mailchimpin embed-koodin GDPR / Marketing Permissions -valintaruutu.
# Esimerkki: gdpr[12345]
PUBLIC_MAILCHIMP_CONSENT_NAME=
PUBLIC_MAILCHIMP_CONSENT_VALUE=Y

# Mailchimpin embed-koodissa näkyvän bottiloukun nimi.
# Esimerkki: b_0123456789abcdef_0123456789
PUBLIC_MAILCHIMP_HONEYPOT_NAME=

# Täytetään, kun Mailchimpiin on luotu piilotettu Finland-ryhmä.
# Esimerkki: group[01245][8]
PUBLIC_MAILCHIMP_GROUP_NAME=
PUBLIC_MAILCHIMP_GROUP_VALUE=
