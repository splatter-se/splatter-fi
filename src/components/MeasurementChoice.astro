---
import { fi } from "../content/fi";
---

<aside class="measurement-choice" data-measurement hidden aria-label={fi.measurement.ariaLabel}>
  <div>
    <strong>{fi.measurement.heading}</strong>
    <p>{fi.measurement.description}</p>
  </div>
  <div class="measurement-actions">
    <button type="button" data-measurement-choice="yes">{fi.measurement.allow}</button>
    <button type="button" data-measurement-choice="no">{fi.measurement.decline}</button>
  </div>
</aside>
