---
import PrivacyDialog from "../components/PrivacyDialog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { fi } from "../content/fi";
import { mailchimpConfig, signupReady } from "../config/site";
import "../styles/global.css";

const attributionFields = Object.entries(mailchimpConfig.attributionFields).filter(
  ([, fieldName]) => Boolean(fieldName),
);
---

<!doctype html>
<html lang="fi-FI">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fi.meta.homeTitle}</title>
    <meta name="description" content={fi.meta.homeDescription} />
    <meta name="theme-color" content="#080708" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href="https://splatter.fi/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fi_FI" />
    <meta property="og:site_name" content="Splatter" />
    <meta property="og:title" content={fi.meta.homeTitle} />
    <meta property="og:description" content={fi.meta.homeDescription} />
    <meta property="og:url" content="https://splatter.fi/" />
    <meta property="og:image" content="https://splatter.fi/brand/splatter-og-1200x630.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fi.meta.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Splatter Suomi",
      url: "https://splatter.fi/",
      inLanguage: "fi-FI",
      description: fi.meta.homeDescription,
      publisher: {
        "@type": "Organization",
        name: "Niche en scène AB",
        url: "https://www.splatter.se/",
      },
    })}></script>
  </head>
  <body>
    <a class="skip-link" href="#signup-form">{fi.landing.skip}</a>
    <div class="page-shell">
      <SiteHeader />
      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-art" aria-hidden="true">
            <img
              src="/brand/hero-poster-wall-1920x1080.webp"
              srcset="/brand/hero-poster-wall-960x540.webp 960w, /brand/hero-poster-wall-1920x1080.webp 1920w, /brand/hero-poster-wall-3840x2160.webp 3840w"
              sizes="100vw"
              alt=""
              width="1920"
              height="1080"
              fetchpriority="high"
              decoding="async"
            />
          </div>
          <div class="hero-scrim" aria-hidden="true"></div>
          <div class="grain" aria-hidden="true"></div>
          <div class="hero-inner">
            <div class="hero-copy">
              <p class="eyebrow"><span aria-hidden="true"></span>{fi.landing.eyebrow}</p>
              <h1 id="hero-title">
                {fi.landing.headingBeforeBreak}<br />{fi.landing.headingAfterBreak}
              </h1>
              <p class="hero-lede">{fi.landing.lede}</p>
              <ul class="genre-list" aria-label={fi.landing.genresLabel}>
                {fi.landing.genres.map((genre) => <li>{genre}</li>)}
              </ul>
            </div>
            <aside class="signup-card" id="ilmoitus" aria-labelledby="signup-title">
              <p class="card-kicker">{fi.landing.cardKicker}</p>
              <h2 id="signup-title">{fi.landing.formHeading}</h2>
              <p class="card-copy">{fi.landing.formDescription}</p>
              <form
                id="signup-form"
                class="signup-form"
                action={signupReady ? mailchimpConfig.action : undefined}
                method="post"
                enctype="multipart/form-data"
                data-signup-form
                data-signup-ready={String(signupReady)}
                tabindex="-1"
              >
                <div class="field">
                  <label for="mce-EMAIL">{fi.landing.emailLabel}</label>
                  <input
                    id="mce-EMAIL"
                    name="EMAIL"
                    type="email"
                    inputmode="email"
                    autocomplete="email"
                    placeholder={fi.landing.emailPlaceholder}
                    maxlength="254"
                    required
                    aria-describedby="email-error"
                  />
                  <p class="field-error" id="email-error" data-email-error aria-live="polite"></p>
                </div>
                <input type="hidden" name="tags" value={mailchimpConfig.tagId} />
                {attributionFields.map(([key, name]) => (
                  <input type="hidden" name={name} value="" data-attribution-field={key} />
                ))}
                <div class="hp-field" aria-hidden="true">
                  <label for="mailchimp-honeypot">{fi.landing.honeypotLabel}</label>
                  <input
                    id="mailchimp-honeypot"
                    name={mailchimpConfig.honeypotName}
                    type="text"
                    tabindex="-1"
                    autocomplete="off"
                    value=""
                  />
                </div>
                <input type="hidden" name="ht" value="" />
                <div class="consent-field">
                  <input
                    id="consent"
                    name={mailchimpConfig.consentName}
                    type="checkbox"
                    value={mailchimpConfig.consentValue}
                    required
                    disabled={!signupReady}
                    aria-describedby="consent-error"
                  />
                  <label for="consent">{fi.landing.consent}</label>
                </div>
                <p class="field-error" id="consent-error" data-consent-error aria-live="polite"></p>
                <button class="submit-button" type="submit" disabled={!signupReady}>
                  <span>{signupReady ? fi.landing.submit : fi.landing.unavailable}</span>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter"></path>
                  </svg>
                </button>
                <p class="form-note">
                  {signupReady ? fi.landing.formNote : fi.landing.formUnavailable}
                </p>
              </form>
            </aside>
          </div>
        </section>
        <section class="about" aria-labelledby="about-title">
          <div class="about-number" aria-hidden="true">01</div>
          <div class="about-copy">
            <p class="eyebrow"><span aria-hidden="true"></span>{fi.landing.aboutKicker}</p>
            <h2 id="about-title">
              {fi.landing.aboutHeadingBeforeBreak}<br />{fi.landing.aboutHeadingAfterBreak}
            </h2>
          </div>
          <div class="about-body">
            <p>{fi.landing.aboutBody}</p>
            <p class="launch-note"><span aria-hidden="true">→</span> {fi.landing.aboutNote}</p>
          </div>
        </section>
        <section class="product-proof" aria-labelledby="proof-title">
          <div class="proof-heading">
            <p class="eyebrow"><span aria-hidden="true"></span>{fi.landing.proofKicker}</p>
            <h2 id="proof-title">{fi.landing.proofHeading}</h2>
            <p>{fi.landing.proofDescription}</p>
          </div>
          <div class="proof-grid">
            {fi.landing.proofImages.map((item) => (
              <figure>
                <img src={item.src} alt={item.alt} width="1280" height="720" loading="lazy" decoding="async" />
                <figcaption>{item.label}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      </main>
      <SiteFooter />
    </div>
    <PrivacyDialog />
    <script src="../scripts/landing.ts"></script>
  </body>
</html>
