---
import PrivacyDialog from "../components/PrivacyDialog.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { fi } from "../content/fi";
import "../styles/global.css";
---

<!doctype html>
<html lang="fi-FI">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fi.meta.thankYouTitle}</title>
    <meta name="description" content={fi.meta.thankYouDescription} />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#080708" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href="https://splatter.fi/kiitos" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fi_FI" />
    <meta property="og:site_name" content="Splatter" />
    <meta property="og:title" content={fi.meta.thankYouTitle} />
    <meta property="og:description" content={fi.meta.thankYouDescription} />
    <meta property="og:url" content="https://splatter.fi/kiitos" />
    <meta property="og:image" content="https://splatter.fi/brand/splatter-og-1200x630.jpg" />
    <meta property="og:image:alt" content={fi.meta.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="thank-page">
    <a class="skip-link" href="#main-content">{fi.thankYou.skip}</a>
    <div class="page-shell">
      <SiteHeader />
      <main class="thank-main" id="main-content">
        <div class="thank-backdrop" aria-hidden="true"></div>
        <section class="thank-unverified" data-unverified aria-labelledby="unverified-title">
          <p class="card-kicker">{fi.thankYou.kicker}</p>
          <h1 id="unverified-title">{fi.thankYou.unverifiedHeading}</h1>
          <p>{fi.thankYou.unverifiedBody}</p>
          <a class="text-link" href="/">← {fi.thankYou.backHome}</a>
        </section>
        <section class="thank-content" data-confirmed hidden aria-labelledby="thank-title">
          <header class="thank-intro">
            <p class="eyebrow"><span aria-hidden="true"></span>{fi.thankYou.kicker}</p>
            <h1 id="thank-title">{fi.thankYou.heading}</h1>
            <p class="thank-lede">{fi.thankYou.lede}</p>
          </header>
          <form class="survey-card" id="survey" data-survey-form novalidate>
            <div class="survey-head">
              <h2>{fi.thankYou.surveyHeading}</h2>
              <p>{fi.thankYou.requiredHint}</p>
            </div>
            <fieldset aria-describedby="subscription-reason-error">
              <legend><span aria-hidden="true">01</span>{fi.thankYou.questionOne} *</legend>
              <div class="option-grid">
                {fi.thankYou.questionOneOptions.map(([value, label]) => (
                  <label class="survey-option">
                    <input type="radio" name="subscriptionReason" value={value} />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
              <p class="survey-error" id="subscription-reason-error" data-error="subscriptionReason" tabindex="-1" aria-live="polite"></p>
            </fieldset>
            <fieldset aria-describedby="viewing-frequency-error">
              <legend><span aria-hidden="true">02</span>{fi.thankYou.questionTwo} *</legend>
              <div class="option-grid compact">
                {fi.thankYou.questionTwoOptions.map(([value, label]) => (
                  <label class="survey-option">
                    <input type="radio" name="viewingFrequency" value={value} />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
              <p class="survey-error" id="viewing-frequency-error" data-error="viewingFrequency" tabindex="-1" aria-live="polite"></p>
            </fieldset>
            <fieldset aria-describedby="genre-status genre-error">
              <legend><span aria-hidden="true">03</span>{fi.thankYou.questionThree} *</legend>
              <p class="genre-status" id="genre-status" data-genre-status aria-live="polite"></p>
              <div class="option-grid genres">
                {fi.thankYou.questionThreeOptions.map(([value, label]) => (
                  <label class="survey-option">
                    <input type="checkbox" name="genres" value={value} />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
              <p class="survey-error" id="genre-error" data-error="genres" tabindex="-1" aria-live="polite"></p>
            </fieldset>
            <fieldset>
              <legend>
                <span aria-hidden="true">04</span>{fi.thankYou.deviceQuestion}
                <small>{fi.thankYou.optional}</small>
              </legend>
              <div class="option-grid compact">
                {fi.thankYou.deviceOptions.map(([value, label]) => (
                  <label class="survey-option">
                    <input type="radio" name="device" value={value} />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <p class="survey-privacy">{fi.thankYou.privacyNote}</p>
            <button class="submit-button survey-submit" type="submit">{fi.thankYou.submit}</button>
            <p class="survey-form-status" data-form-status tabindex="-1" role="status" aria-live="polite"></p>
            <noscript><p class="survey-form-status">{fi.thankYou.noScript}</p></noscript>
          </form>
        </section>
      </main>
      <SiteFooter />
    </div>
    <PrivacyDialog />
    <script src="../scripts/thank-you.ts"></script>
  </body>
</html>
